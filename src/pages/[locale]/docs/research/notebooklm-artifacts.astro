---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ArtifactCard from '../../../../components/ArtifactCard.astro';
import artifactsCatalog from '../../../../data/artifacts.json';
import { LOCALES, normalizeLocale } from '../../../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.params.locale);
const artifacts = artifactsCatalog.artifacts;
const artifactCount = artifacts.length;
const artifactLabel = `${artifactCount} artifact${artifactCount === 1 ? '' : 's'}`;
const pageDescription = `All ${artifactLabel} from the current NotebookLM inventory: audio, decks, infographics, reports, tables, videos, flashcards, quizzes, and mind maps.`;
const pageSummary = `${artifactCount} repository-tracked NotebookLM files are present in the validated inventory. Browse, preview, and download.`;
const kinds = Array.from(new Set(artifacts.map((artifact) => artifact.kind))).sort();
---

<BaseLayout 
  title="NotebookLM Artifacts — iverif.io" 
  description={pageDescription}
  locale={locale}
>
  <div class="doc-stage">
    <div class="doc-shell" style="max-width: 1080px;">
      <article class="doc-panel glass-panel" style="padding: var(--space-5);">
        <header class="doc-header">
          <div class="doc-header__meta">
            <span class="pill pill--soft">Research</span>
            <span class="pill pill--warm">{artifactLabel}</span>
          </div>
          <h1>NotebookLM Artifacts</h1>
          <p class="doc-description" style="max-width: 60ch;">
            {pageSummary}
          </p>
        </header>

        <!-- Filters (client) -->
        <div class="artifact-filters" id="filters">
          <button class="artifact-filter is-active" data-kind="all">All</button>
          {kinds.map(k => (
            <button class="artifact-filter" data-kind={k}>{k}</button>
          ))}
        </div>

        <!-- Rich Gallery -->
        <div class="artifact-gallery" id="gallery">
          {artifacts.map((a, idx) => {
            const href = `/${a.file}`;
            const isAudio = a.kind === 'Audio';
            const isImage = a.kind === 'Infographic';
            return (
              <ArtifactCard
                kind={a.kind}
                title={a.title}
                desc={a.description}
                href={href}
                isImage={isImage}
                isAudio={isAudio}
                idx={idx}
              />
            );
          })}
        </div>

        <p style="margin-top:var(--space-5);font-size:0.75rem;color:var(--text-muted);max-width:60ch">
          Source: public/notebooklm/ — delivered by NotebookLM Wave 7. Filenames are authoritative; no invented assets.
        </p>
      </article>
    </div>
  </div>

  <!-- Artifact View Modal (reimagined "artefact view page" affordance) -->
  <div id="artifact-modal" class="artifact-modal" aria-hidden="true">
    <div class="artifact-modal__content" role="dialog" aria-modal="true">
      <button class="artifact-modal__close" id="modal-close" aria-label="Close">×</button>
      <div id="modal-body"></div>
    </div>
  </div>
</BaseLayout>

<script>
  (function() {
    const filters = document.getElementById('filters')! as HTMLElement;
    const gallery = document.getElementById('gallery')! as HTMLElement;
    const modal = document.getElementById('artifact-modal')! as HTMLElement;
    const modalBody = document.getElementById('modal-body')! as HTMLElement;
    const closeBtn = document.getElementById('modal-close')! as HTMLElement;

    if (!filters || !gallery || !modal || !modalBody || !closeBtn) return;

    const cards = Array.from(gallery.querySelectorAll('.artifact-card'));

    // Filter logic
    filters.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest('.artifact-filter') as HTMLElement | null;
      if (!btn) return;
      const kind = (btn as HTMLElement).dataset.kind;

      filters.querySelectorAll('.artifact-filter').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      cards.forEach((card: Element) => {
        const el = card as HTMLElement;
        if (kind === 'all' || el.dataset.kind === kind) {
          el.style.display = '';
        } else {
          el.style.display = 'none';
        }
      });
    });

    // Modal view (reimagined artifact detail)
    function openModal(idx: number) {
      const card = cards[idx] as HTMLElement | undefined;
      if (!card) return;
      const kind = (card as HTMLElement).dataset.kind || '';
      const h3 = card.querySelector('h3') as HTMLElement | null;
      const p = card.querySelector('p:last-of-type') as HTMLElement | null;
      const mediaEl = card.querySelector('.artifact-card__media') as HTMLElement | null;
      const aEl = card.querySelector('a') as HTMLAnchorElement | null;
      const title = h3?.textContent || '';
      const desc = p?.textContent || '';
      const media = mediaEl?.innerHTML || '';
      const href = aEl?.getAttribute('href') || '#';

      modalBody.innerHTML = `
        <div style="max-width:100%">
          <p style="font-size:0.625rem;text-transform:uppercase;letter-spacing:0.12em;color:var(--brand-primary);margin:0 0 4px">${kind}</p>
          <h2 style="margin:0 0 8px;font-size:1.5rem">${title}</h2>
          <p style="max-width:65ch;color:var(--text-muted)">${desc}</p>
          <div style="margin:1rem 0 1.25rem;border:1px solid var(--surface-border);padding:0.75rem;border-radius:2px;background:var(--surface-canvas)">
            ${media}
          </div>
          <div style="display:flex;gap:0.75rem;flex-wrap:wrap">
            <a href="${href}" target="_blank" class="cta cta--primary" style="font-size:0.875rem">Open original file</a>
            <button class="cta cta--secondary" style="font-size:0.875rem" id="modal-close-2">Close</button>
          </div>
          <p style="margin-top:1rem;font-size:0.6875rem;color:var(--text-soft)">File served from /notebooklm/ — part of the official NotebookLM deliverable set.</p>
        </div>
      `;
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');

      const c2 = modalBody.querySelector('#modal-close-2');
      if (c2) c2.addEventListener('click', closeModal, { once: true });
    }

    function closeModal() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      modalBody.innerHTML = '';
    }

    // Bind view buttons
    gallery.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement | null)?.closest('[data-view]') as HTMLElement | null;
      if (!btn) return;
      const idx = parseInt(btn.dataset.view || '0', 10);
      openModal(idx);
    });

    // Close handlers
    modal.addEventListener('click', (e) => {
      if ((e.target as HTMLElement | null) === modal) closeModal();
    });
    closeBtn.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });

    // Keyboard accessibility for filters
    filters.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const btn = (e.target as HTMLElement | null)?.closest('.artifact-filter') as HTMLElement | null;
        if (btn) {
          e.preventDefault();
          btn.click();
        }
      }
    });
  })();
</script>
