---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import ArtifactCard from '../../../../components/ArtifactCard.astro';
import siteData from '../../../../data/site-data.json';
import { LOCALES, normalizeLocale, localizedPath, t } from '../../../../i18n';

export async function getStaticPaths() {
  return LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = normalizeLocale(Astro.params.locale);
const copy = t(locale);

// Real artifacts from public/notebooklm (authoritative list, no invented names)
const artifacts = [
  { file: 'audio-brief-short.mp3', kind: 'Audio', title: 'Brief Audio Overview', desc: 'Short synthesized overview of the iverif brand and value proposition.' },
  { file: 'audio-debate.mp3', kind: 'Audio', title: 'Debate Audio', desc: 'Multi-voice discussion surfacing tensions and strengths in positioning.' },
  { file: 'audio-deep-dive-long.mp3', kind: 'Audio', title: 'Deep Dive Audio Overview', desc: '80-minute full brand walkthrough for EU energy subsidy operators.' },
  { file: 'deck-detailed-full.pdf', kind: 'Deck', title: 'Brand Intelligence Report (Full)', desc: 'Comprehensive brand report and study guide.' },
  { file: 'deck-detailed-short.pdf', kind: 'Deck', title: 'Comprehensive Study Guide', desc: 'Condensed study guide for quick reference.' },
  { file: 'deck-presenter-full.pdf', kind: 'Deck', title: 'Validation Engine Presentation (Full)', desc: 'Full presenter deck on the AI document validation engine.' },
  { file: 'deck-presenter-short.pdf', kind: 'Deck', title: 'Validation Engine Presentation (Short)', desc: 'Concise version of the validation engine deck.' },
  { file: 'infographic-landscape.png', kind: 'Infographic', title: 'Brand Strategy Overview', desc: 'High-level mapping of positioning, trust signals, and regulatory differentiation.' },
  { file: 'infographic-portrait.png', kind: 'Infographic', title: 'Regulatory Compliance Flow', desc: 'Document validation pipeline and audit trail generation.' },
  { file: 'infographic-square.png', kind: 'Infographic', title: 'Validation Journey Map', desc: 'End-to-end operator journey with validation checkpoints.' },
  { file: 'mind-map.json', kind: 'Mind Map', title: 'Mind Map (Core)', desc: 'Core brand mind map exported from NotebookLM.' },
  { file: 'mind-map (2).json', kind: 'Mind Map', title: 'Mind Map (Extended)', desc: 'Extended mind map with additional clusters.' },
  { file: 'flashcards-detailed.json', kind: 'Flashcards', title: 'Detailed Flashcards', desc: 'Deep flashcards for brand, product, and compliance concepts.' },
  { file: 'flashcards-standard.json', kind: 'Flashcards', title: 'Standard Flashcards', desc: 'Core set of flashcards for quick review.' },
  { file: 'quiz-hard.json', kind: 'Quiz', title: 'Hard Quiz', desc: 'Challenging quiz to test depth of brand and regulatory knowledge.' },
];

const kinds = Array.from(new Set(artifacts.map(a => a.kind))).sort();
---

<BaseLayout 
  title="NotebookLM Artifacts — iverif.io" 
  description="All 24+ NotebookLM artifacts: audio overviews, infographics, decks, mind maps, flashcards, and quizzes for the iverif brand." 
  locale={locale}
>
  <div class="doc-stage">
    <div class="doc-shell" style="max-width: 1080px;">
      <article class="doc-panel glass-panel" style="padding: var(--space-5);">
        <header class="doc-header">
          <div class="doc-header__meta">
            <span class="pill pill--soft">Research</span>
            <span class="pill pill--warm">{artifacts.length} artifacts</span>
          </div>
          <h1>NotebookLM Artifacts</h1>
          <p class="doc-description" style="max-width: 60ch;">
            24 artifacts generated by NotebookLM across 5 source documents. All files are real deliverables from the brand launch run. Browse, preview, and download.
          </p>
        </header>

        <!-- Filters (client) -->
        <div class="artifact-filters" id="filters">
          <button class="artifact-filter is-active" data-kind="all">All</button>
          {kinds.map(k => (
            <button class="artifact-filter" data-kind={k}>{k}</button>
          ))}
        </div>

        <!-- Rich Gallery -->
        <div class="artifact-gallery" id="gallery">
          {artifacts.map((a, idx) => {
            const href = `/notebooklm/${a.file}`;
            const isAudio = a.kind === 'Audio';
            const isImage = a.kind === 'Infographic';
            return (
              <ArtifactCard
                kind={a.kind}
                title={a.title}
                desc={a.desc}
                href={href}
                isImage={isImage}
                isAudio={isAudio}
                idx={idx}
              />
            );
          })}
        </div>

        <p style="margin-top:var(--space-5);font-size:0.75rem;color:var(--text-muted);max-width:60ch">
          Source: public/notebooklm/ — delivered by NotebookLM Wave 7. Filenames are authoritative; no invented assets.
        </p>
      </article>
    </div>
  </div>

  <!-- Artifact View Modal (reimagined "artefact view page" affordance) -->
  <div id="artifact-modal" class="artifact-modal" aria-hidden="true">
    <div class="artifact-modal__content" role="dialog" aria-modal="true">
      <button class="artifact-modal__close" id="modal-close" aria-label="Close">×</button>
      <div id="modal-body"></div>
    </div>
  </div>
</BaseLayout>

<script>
  (function() {
    const filters = document.getElementById('filters');
    const gallery = document.getElementById('gallery');
    const modal = document.getElementById('artifact-modal');
    const modalBody = document.getElementById('modal-body');
    const closeBtn = document.getElementById('modal-close');

    if (!filters || !gallery) return;

    const cards = Array.from(gallery.querySelectorAll('.artifact-card'));

    // Filter logic
    filters.addEventListener('click', (e) => {
      const btn = e.target.closest('.artifact-filter');
      if (!btn) return;
      const kind = btn.dataset.kind;

      filters.querySelectorAll('.artifact-filter').forEach(b => b.classList.remove('is-active'));
      btn.classList.add('is-active');

      cards.forEach(card => {
        if (kind === 'all' || card.dataset.kind === kind) {
          card.style.display = '';
        } else {
          card.style.display = 'none';
        }
      });
    });

    // Modal view (reimagined artifact detail)
    function openModal(idx) {
      const card = cards[idx];
      if (!card) return;
      const kind = card.dataset.kind;
      const title = card.querySelector('h3').textContent;
      const desc = card.querySelector('p:last-of-type').textContent;
      const media = card.querySelector('.artifact-card__media').innerHTML;
      const href = card.querySelector('a')?.getAttribute('href') || '#';

      modalBody.innerHTML = `
        <div style="max-width:100%">
          <p style="font-size:0.625rem;text-transform:uppercase;letter-spacing:0.12em;color:var(--brand-primary);margin:0 0 4px">${kind}</p>
          <h2 style="margin:0 0 8px;font-size:1.5rem">${title}</h2>
          <p style="max-width:65ch;color:var(--text-muted)">${desc}</p>
          <div style="margin:1rem 0 1.25rem;border:1px solid var(--surface-border);padding:0.75rem;border-radius:2px;background:var(--surface-canvas)">
            ${media}
          </div>
          <div style="display:flex;gap:0.75rem;flex-wrap:wrap">
            <a href="${href}" target="_blank" class="cta cta--primary" style="font-size:0.875rem">Open original file</a>
            <button class="cta cta--secondary" style="font-size:0.875rem" id="modal-close-2">Close</button>
          </div>
          <p style="margin-top:1rem;font-size:0.6875rem;color:var(--text-soft)">File served from /notebooklm/ — part of the official NotebookLM deliverable set.</p>
        </div>
      `;
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');

      const c2 = modalBody.querySelector('#modal-close-2');
      if (c2) c2.addEventListener('click', closeModal, { once: true });
    }

    function closeModal() {
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      modalBody.innerHTML = '';
    }

    // Bind view buttons
    gallery.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-view]');
      if (!btn) return;
      const idx = parseInt(btn.dataset.view, 10);
      openModal(idx);
    });

    // Close handlers
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    closeBtn.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('open')) closeModal();
    });

    // Keyboard accessibility for filters
    filters.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        const btn = e.target.closest('.artifact-filter');
        if (btn) {
          e.preventDefault();
          btn.click();
        }
      }
    });
  })();
</script>
