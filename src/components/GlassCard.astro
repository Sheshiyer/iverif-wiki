---
interface Props {
  href?: string;
  interactive?: boolean;
  tone?: 'default' | 'warm' | 'signal' | 'accent';
  class?: string;
}

const {
  href,
  interactive = false,
  tone = 'default',
  class: className = '',
} = Astro.props;

const Tag = href ? 'a' : 'div';
const useSwiss = tone === 'default';
---

<Tag
  href={href}
  class:list={[
    useSwiss ? 'swiss-panel' : 'glass-card',
    !useSwiss && `glass-card--${tone}`,
    { 'glass-card--interactive': !useSwiss && (interactive || Boolean(href)) },
    className,
  ]}
>
  <slot />
</Tag>
