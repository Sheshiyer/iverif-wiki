---
import { getCollection } from 'astro:content';
import siteData from '../data/site-data.json';
import type { Locale } from '../i18n';
import { localizedPath, localizedDocTitle, plainText, t } from '../i18n';

interface Props {
  locale: Locale;
  currentPath?: string;
}

const { locale, currentPath } = Astro.props;
const copy = t(locale);
const docs = await getCollection('docs');
const localizedDocs = docs;
const categories: Record<string, typeof localizedDocs> = {};

for (const doc of localizedDocs) {
  const category = (doc.data.category || 'general').toString();
  if (!categories[category]) categories[category] = [];
  categories[category].push(doc);
}

for (const category of Object.keys(categories)) {
  categories[category].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
}

const categoryOrder = ['general', 'product', 'brand', 'audience', 'marketing'];
const sortedCategories = Object.entries(categories).sort(([a], [b]) => {
  const ai = categoryOrder.indexOf(a);
  const bi = categoryOrder.indexOf(b);
  const aRank = ai === -1 ? 99 : ai;
  const bRank = bi === -1 ? 99 : bi;
  return aRank === bRank ? a.localeCompare(b) : aRank - bRank;
});

function isActive(docSlug: string): boolean {
  if (!currentPath) return false;
  const docPath = localizedPath(locale, `/docs/${docSlug}`);
  return currentPath === docPath || currentPath.startsWith(`${docPath}/`);
}
---

<nav class="portal-nav" aria-label="Documentation">
  <a href={localizedPath(locale, '/')} class="brand-lockup">
    <span class="brand-lockup__orb">iV</span>
    <span>
      <strong>{siteData.brandName}</strong>
      <small>{siteData.tagline}</small>
    </span>
  </a>

  <div class="brand-summary glass-panel glass-panel--soft">
    <p class="eyebrow">{siteData.themeName}</p>
    <h2>{siteData.heroTitle}</h2>
    <p>{siteData.heroSubtitle}</p>
  </div>

  <div class="portal-nav__quicklinks">
    <a class="quicklink" href={localizedPath(locale, '/')}>{copy.shell.portalHome}</a>
    <a class="quicklink" href={localizedPath(locale, siteData.docsHomeHref || '/docs/index')}>{copy.shell.docsIndex}</a>
    <a class="quicklink" href={localizedPath(locale, siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts')}>{copy.shell.notebooklm}</a>
  </div>

  <div class="sidebar-search">
    <input 
      type="search" 
      id="sidebar-search"
      placeholder="Search docs..."
      aria-label="Search documentation"
      class="sidebar-search__input"
    />
  </div>

  {sortedCategories.map(([category, categoryDocs]) => (
    <section class="nav-section">
      <div class="nav-section__header">
        <p class="eyebrow eyebrow--muted">{copy.categories[category as keyof typeof copy.categories] || category}</p>
        <span>{categoryDocs.length}</span>
      </div>
      <ul class="nav-list">
        {categoryDocs.map((doc) => (
          <li>
            <a 
              href={localizedPath(locale, `/docs/${doc.slug}`)} 
              class={`nav-link${isActive(doc.slug) ? ' is-active' : ''}`}
              aria-current={isActive(doc.slug) ? 'page' : undefined}
              data-search-text={`${doc.data.title} ${doc.data.description || ''}`.toLowerCase()}
            >
              <span>
                <strong>{plainText(localizedDocTitle(locale, doc.slug, doc.data.title))}</strong>
                {doc.data.description && <small>{plainText(doc.data.description)}</small>}
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</nav>

<script is:inline>
  (function() {
    const searchInput = document.getElementById('sidebar-search');
    if (!searchInput) return;
    
    searchInput.addEventListener('input', function(e) {
      const query = e.target.value.toLowerCase().trim();
      const navLinks = document.querySelectorAll('.nav-link[data-search-text]');
      
      navLinks.forEach(function(link) {
        const text = link.getAttribute('data-search-text') || '';
        const parentSection = link.closest('.nav-section');
        
        if (query === '') {
          link.style.display = '';
          if (parentSection) parentSection.style.display = '';
        } else if (text.includes(query)) {
          link.style.display = '';
          if (parentSection) parentSection.style.display = '';
        } else {
          link.style.display = 'none';
        }
      });
      
      // Hide empty sections
      document.querySelectorAll('.nav-section').forEach(function(section) {
        const visibleLinks = section.querySelectorAll('.nav-link:not([style*="display: none"])');
        if (visibleLinks.length === 0 && query !== '') {
          section.style.display = 'none';
        } else {
          section.style.display = '';
        }
      });
    });
  })();
</script>