---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GlassCard from './GlassCard.astro';
import siteData from '../data/site-data.json';
import type { Locale } from '../i18n';
import { localizedDocTitle, localizedFeature, localizedPath, plainText, t } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = t(locale);
const docs = await getCollection('docs');
const localizedDocs = docs;
const docsBySlug = new Map(localizedDocs.map((doc) => [doc.slug, doc]));
const metrics = siteData.metrics || [];
const storyPillars = siteData.storyPillars || [];
const featuredDocs = siteData.featuredDocs || [];
const visualHighlights = siteData.visualHighlights || [];
const notebooklmHighlights = siteData.notebooklmHighlights || [];

const categories: Record<string, typeof localizedDocs> = {};
for (const doc of localizedDocs) {
  const category = (doc.data.category || 'general').toString();
  if (!categories[category]) categories[category] = [];
  categories[category].push(doc);
}
for (const category of Object.keys(categories)) {
  categories[category].sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));
}
const orderedCategories = Object.entries(categories).sort(([a], [b]) => {
  const order = ['general', 'product', 'brand', 'audience', 'marketing'];
  return (order.indexOf(a) === -1 ? 99 : order.indexOf(a)) - (order.indexOf(b) === -1 ? 99 : order.indexOf(b));
});
---

<BaseLayout title={`${siteData.brandName} Launch Portal`} description={siteData.heroSubtitle || siteData.tagline} locale={locale}>
  <section class="home-stage swiss-home">
    <!-- Asymmetric Hero: Swiss narrow copy + visual (taste: split, anti-center) -->
    <section class="hero hero--asymmetric">
      <div class="hero-copy" style="max-width: 60ch;">
        <p class="eyebrow">{siteData.themeName.toUpperCase()} · {siteData.launchChannel}</p>
        <h1 class="hero-title">{siteData.heroTitle}</h1>
        <p class="hero-subtitle">{siteData.heroSubtitle}</p>
        {siteData.heroDescription && <p class="hero-description">{siteData.heroDescription}</p>}

        <div class="hero-actions">
          <a class="cta cta--primary" href={localizedPath(locale, siteData.heroPrimaryHref || '/docs/product/overview')}>Explore the product story</a>
          <a class="cta cta--secondary" href={localizedPath(locale, siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts')}>Open research & NotebookLM</a>
        </div>

        {storyPillars.length > 0 && (
          <div class="story-pillars">
            {storyPillars.map((pillar) => <span class="pill pill--soft">{pillar}</span>)}
          </div>
        )}

        {metrics.length > 0 && (
          <div class="metric-row">
            {metrics.map((metric) => (
              <div class="metric" key={metric.label}>
                <strong>{metric.value}</strong>
                <span>{metric.label}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="hero-visual">
        <div class="hero-visual__frame">
          {siteData.heroImage && (
            <img 
              src={siteData.heroImage} 
              alt={siteData.heroImageAlt || siteData.brandName} 
              class="hero-visual__img"
            />
          )}
        </div>
        <div class="hero-visual__meta">
          <p class="eyebrow">{copy.shell.launchReadyPortal}</p>
          <p class="brand-lockup-small"><strong>{siteData.brandName}</strong> — {siteData.tagline}</p>
        </div>
      </div>
    </section>

    <!-- Curated tracks: Swiss section + tasteful grid (labels below, 2-col asymmetric friendly) -->
    <section class="home-section" data-scroll>
      <div class="section-heading">
        <p class="eyebrow">{copy.home.curatedLaunchTracks}</p>
        <h2>{copy.home.homeHeading}</h2>
        <p style="max-width:60ch">{copy.home.homeBlurb}</p>
      </div>
      <div class="feature-grid swiss-grid-2">
        {featuredDocs.map((doc) => {
          const slug = (doc.href || '').replace(/^\/docs\//, '').replace(/^\//, '');
          const localizedDoc = docsBySlug.get(slug);
          const localized = localizedFeature(locale, doc.href, {
            title: localizedDoc?.data.title || doc.title,
            eyebrow: doc.eyebrow,
            description: localizedDoc?.data.description || doc.description,
          });
          return (
            <a class="swiss-panel feature-panel" href={localizedPath(locale, doc.href)}>
              <p class="panel-eyebrow">{plainText(localized.eyebrow)}</p>
              <h3>{plainText(localized.title)}</h3>
              <p>{plainText(localized.description)}</p>
              <span class="panel-link">{copy.shell.openSection} →</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Visual world: bento-ish 4-col, images first, titles/descriptions below (taste anti 3-equal, Swiss 12-col) -->
    <section class="home-section" data-scroll>
      <div class="section-heading">
        <p class="eyebrow">{copy.home.visualWorld}</p>
        <h2>{copy.home.visualHeading}</h2>
      </div>
      <div class="visual-grid swiss-grid-4">
        {visualHighlights.map((item) => (
          <a class="swiss-panel visual-panel" href={localizedPath(locale, item.href)}>
            {item.image && <img src={item.image} alt={item.title} class="panel-image" />}
            <div class="panel-body">
              <p class="panel-eyebrow">{item.eyebrow}</p>
              <h3>{item.title}</h3>
              <p>{item.description}</p>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Dual: Knowledge map (list) + Research spotlight (taste: dual narrow, Swiss generous whitespace) -->
    <section class="home-section home-section--dual" data-scroll>
      <div class="swiss-panel knowledge-panel">
        <div class="section-heading section-heading--compact">
          <p class="eyebrow">{copy.home.knowledgeMap}</p>
          <h2>{copy.home.knowledgeHeading}</h2>
        </div>
        <div class="knowledge-grid">
          {orderedCategories.map(([category, categoryDocs]) => (
            <div class="knowledge-col" key={category}>
              <p class="panel-eyebrow">{copy.categories[category as keyof typeof copy.categories] || category}</p>
              <ul class="knowledge-list">
                {categoryDocs.map((doc) => (
                  <li>
                    <a href={localizedPath(locale, `/docs/${doc.slug}`)}>
                      {plainText(localizedDocTitle(locale, doc.slug, doc.data.title))}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <div class="swiss-panel research-panel">
        <div class="section-heading section-heading--compact">
          <p class="eyebrow">{copy.home.notebooklmSpotlight}</p>
          <h2>{copy.home.notebooklmHeading}</h2>
        </div>
        <div class="research-list">
          {notebooklmHighlights.map((item) => (
            <a class="research-row" href={localizedPath(locale, item.href || siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts')}>
              {item.image && <img src={item.image} alt={item.title} class="research-thumb" />}
              <div class="research-meta">
                <p class="panel-eyebrow">{item.kind}</p>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </a>
          ))}
        </div>
        <a class="panel-link" href={localizedPath(locale, siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts')}>Browse all NotebookLM artifacts →</a>
      </div>
    </section>

    <!-- Closing: Swiss restrained banner -->
    <section class="home-section" data-scroll>
      <div class="swiss-panel closing-panel accent">
        <div>
          <p class="eyebrow">{copy.shell.freshBuild}</p>
          <h2>{siteData.runLabel}</h2>
          <p style="max-width:60ch">Published {siteData.publishedAtHuman}. This portal keeps the wiki depth while presenting it through the active brand system.</p>
        </div>
        <div class="closing-actions">
          <a class="cta cta--secondary" href={localizedPath(locale, siteData.docsHomeHref || '/docs/index')}>{copy.shell.openDocsIndex}</a>
          <a class="cta cta--primary" href={localizedPath(locale, siteData.heroSecondaryHref || '/docs/research/notebooklm-artifacts')}>{copy.shell.openResearchHub}</a>
        </div>
      </div>
    </section>
  </section>
</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  let ctx;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  function cleanup() {
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
    ctx?.revert?.();
    ctx = undefined;
  }

  function init() {
    cleanup();
    if (reduceMotion.matches) return;

    ctx = gsap.context(() => {
      // Subtle scroll-triggered reveals for home sections (transform + opacity only, Swiss restraint)
      gsap.utils.toArray('[data-scroll]').forEach((section, i) => {
        gsap.fromTo(
          section,
          { opacity: 0.6, y: 24 },
          {
            opacity: 1,
            y: 0,
            duration: 0.65,
            ease: 'power2.out',
            delay: i * 0.03,
            scrollTrigger: {
              trigger: section,
              start: 'top 88%',
              once: true,
            },
          }
        );
      });

      // Light stagger on visual panels
      gsap.fromTo(
        '.visual-panel',
        { opacity: 0, y: 16 },
        {
          opacity: 1,
          y: 0,
          duration: 0.5,
          ease: 'power2.out',
          stagger: 0.06,
          scrollTrigger: {
            trigger: '.visual-grid',
            start: 'top 85%',
          },
        }
      );
    });

    requestAnimationFrame(() => ScrollTrigger.refresh());
  }

  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', cleanup);
  if (document.readyState !== 'loading') init();
</script>
