---
interface Props {
  kind: string;
  title: string;
  desc: string;
  href: string;
  isImage?: boolean;
  isAudio?: boolean;
  idx?: number;
}

const { kind, title, desc, href, isImage, isAudio, idx } = Astro.props;
---

<div class="artifact-card" data-kind={kind} data-idx={idx ?? ''}>
  <div class="artifact-card__media">
    {isImage && <img src={href} alt={title} loading="lazy" />}
    {isAudio && <audio controls src={href} preload="none" />}
    {!isImage && !isAudio && (
      <div style="padding:1rem;text-align:center;font-size:0.75rem;color:var(--text-muted)">{kind}</div>
    )}
  </div>
  <div class="artifact-card__body">
    <p class="artifact-card__kind">{kind}</p>
    <h3>{title}</h3>
    <p>{desc}</p>
    <div style="margin-top:0.75rem;display:flex;gap:0.5rem;flex-wrap:wrap">
      <a href={href} target="_blank" class="feature-link" style="font-size:0.75rem">Open / Download</a>
      {typeof idx === 'number' && (
        <button 
          class="feature-link" 
          style="font-size:0.75rem;background:none;border:none;padding:0;cursor:pointer" 
          data-view={idx}
        >
          View
        </button>
      )}
    </div>
  </div>
</div>
