---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  title: string;
  description?: string;
  category?: string;
  headings?: { depth: number; slug: string; text: string }[];
  locale: Locale;
  lastUpdated?: string;
}

const { title, description, category, headings = [], locale, lastUpdated } = Astro.props;
const copy = t(locale);
const content = await Astro.slots.render('default');
const wordCount = content.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 210));
---

<BaseLayout title={title} description={description} locale={locale}>
  <section class="doc-stage">
    <div class="doc-shell">
      <article class="doc-panel swiss-panel">
        <Breadcrumb title={title} category={category} locale={locale} />

        <header class="doc-header">
          <div class="doc-header__meta">
            {category && <span class="pill pill--soft">{category}</span>}
            <span class="pill pill--warm">{readingTime} {copy.shell.minRead}</span>
            {lastUpdated && <span class="pill pill--soft">Updated {lastUpdated}</span>}
          </div>
          <h1>{title}</h1>
          {description && <p class="doc-description" style="max-width:60ch">{description}</p>}
        </header>

        <div class="prose portal-prose" id="doc-content">
          <slot />
        </div>
      </article>

      {headings.length > 0 && (
        <div class="doc-sidebar">
          <TableOfContents headings={headings} locale={locale} />
        </div>
      )}
    </div>
  </section>

  <script is:inline>
    (function() {
      // Wrap tables for horizontal scrolling
      document.querySelectorAll('.portal-prose table').forEach(function(table) {
        if (!table.parentElement.classList.contains('table-wrapper')) {
          const wrapper = document.createElement('div');
          wrapper.className = 'table-wrapper';
          table.parentNode.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        }
      });

      // Add copy buttons to code blocks
      document.querySelectorAll('.portal-prose pre').forEach(function(pre) {
        if (pre.parentElement.classList.contains('code-block-wrapper')) return;
        
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);
        
        const button = document.createElement('button');
        button.className = 'copy-button';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code to clipboard');
        
        button.addEventListener('click', function() {
          const code = pre.querySelector('code');
          const text = code ? code.textContent : pre.textContent;
          navigator.clipboard.writeText(text).then(function() {
            button.textContent = 'Copied';
            button.classList.add('copied');
            setTimeout(function() {
              button.textContent = 'Copy';
              button.classList.remove('copied');
            }, 2000);
          });
        });
        
        wrapper.appendChild(button);
      });
    })();
  </script>

  <script>
    import gsap from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';

    gsap.registerPlugin(ScrollTrigger);

    let ctx;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    function cleanup() {
      ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
      ctx?.revert?.();
      ctx = undefined;
    }

    function initDocGSAP() {
      cleanup();
      if (reduceMotion.matches) return;

      ctx = gsap.context(() => {
        // Subtle scroll reveals for Swiss doc prose (headings, images, quotes)
        gsap.fromTo('.portal-prose h2', 
          { opacity: 0.7, y: 16 }, 
          { 
            opacity: 1, 
            y: 0, 
            duration: 0.55, 
            ease: 'power2.out',
            scrollTrigger: { trigger: '.portal-prose h2', start: 'top 85%', once: true }
          }
        );

        gsap.fromTo('.portal-prose img, .portal-prose blockquote', 
          { opacity: 0.65, y: 12 }, 
          { 
            opacity: 1, 
            y: 0, 
            duration: 0.6, 
            ease: 'power2.out',
            stagger: 0.08,
            scrollTrigger: { 
              trigger: '.portal-prose', 
              start: 'top 80%',
            }
          }
        );
      });

      requestAnimationFrame(() => ScrollTrigger.refresh());
    }

    document.addEventListener('astro:page-load', initDocGSAP);
    document.addEventListener('astro:before-swap', cleanup);
    if (document.readyState !== 'loading') initDocGSAP();
  </script>
</BaseLayout>