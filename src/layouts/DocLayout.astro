---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import TableOfContents from '../components/TableOfContents.astro';
import type { Locale } from '../i18n';
import { t } from '../i18n';

interface Props {
  title: string;
  description?: string;
  category?: string;
  headings?: { depth: number; slug: string; text: string }[];
  locale: Locale;
  lastUpdated?: string;
}

const { title, description, category, headings = [], locale, lastUpdated } = Astro.props;
const copy = t(locale);
const content = await Astro.slots.render('default');
const wordCount = content.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.ceil(wordCount / 210));
---

<BaseLayout title={title} description={description} locale={locale}>
  <section class="doc-stage">
    <div class="doc-shell">
      <article class="doc-panel glass-panel">
        <Breadcrumb title={title} category={category} locale={locale} />

        <header class="doc-header">
          <div class="doc-header__meta">
            {category && <span class="pill pill--soft">{category}</span>}
            <span class="pill pill--warm">{readingTime} {copy.shell.minRead}</span>
            {lastUpdated && <span class="pill pill--soft">Updated {lastUpdated}</span>}
          </div>
          <h1>{title}</h1>
          {description && <p class="doc-description">{description}</p>}
        </header>

        <div class="prose portal-prose" id="doc-content">
          <slot />
        </div>
      </article>

      {headings.length > 0 && (
        <div class="doc-sidebar">
          <TableOfContents headings={headings} locale={locale} />
        </div>
      )}
    </div>
  </section>

  <script is:inline>
    (function() {
      // Wrap tables for horizontal scrolling
      document.querySelectorAll('.portal-prose table').forEach(function(table) {
        if (!table.parentElement.classList.contains('table-wrapper')) {
          const wrapper = document.createElement('div');
          wrapper.className = 'table-wrapper';
          table.parentNode.insertBefore(wrapper, table);
          wrapper.appendChild(table);
        }
      });

      // Add copy buttons to code blocks
      document.querySelectorAll('.portal-prose pre').forEach(function(pre) {
        if (pre.parentElement.classList.contains('code-block-wrapper')) return;
        
        const wrapper = document.createElement('div');
        wrapper.className = 'code-block-wrapper';
        pre.parentNode.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);
        
        const button = document.createElement('button');
        button.className = 'copy-button';
        button.textContent = 'Copy';
        button.setAttribute('aria-label', 'Copy code to clipboard');
        
        button.addEventListener('click', function() {
          const code = pre.querySelector('code');
          const text = code ? code.textContent : pre.textContent;
          navigator.clipboard.writeText(text).then(function() {
            button.textContent = 'Copied';
            button.classList.add('copied');
            setTimeout(function() {
              button.textContent = 'Copy';
              button.classList.remove('copied');
            }, 2000);
          });
        });
        
        wrapper.appendChild(button);
      });
    })();
  </script>
</BaseLayout>